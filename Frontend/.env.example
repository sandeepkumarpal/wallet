NEXT_PUBLIC_API_URL=
# Backend origin used by Next.js rewrites in production (no trailing slash).
# Local default is http://127.0.0.1:5000
BACKEND_URL=
# Web client ID from Google Cloud Console → Credentials → OAuth 2.0 Client IDs.
# Also add Authorized JavaScript origins there, e.g.:
#   http://localhost:5173
#   http://127.0.0.1:5173
#   http://YOUR_LAN_IP:5173  (phone / network testing)
#   https://YOUR_FRONTEND_HOST
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
